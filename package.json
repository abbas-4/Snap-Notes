{
  "name": "snap-notes",
  "private": true,
  "version": "0.1.0",
  "description": "A flashcard and study app: create cards, then study, quiz, learn, and match.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "check:functions": "npx --yes deno@2.9.6 check --config supabase/functions/generate-flashcards/deno.json supabase/functions/generate-flashcards/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:integration": "node scripts/test-integration.mjs",
    "verify:legacy": "node scripts/verify-legacy.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "db:start": "npx --yes supabase@2.122.0 start -x studio,imgproxy,vector,logflare,supavisor,postgres-meta",
    "db:stop": "npx --yes supabase@2.122.0 stop",
    "db:reset": "npx --yes supabase@2.122.0 db reset",
    "db:status": "npx --yes supabase@2.122.0 status"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.11.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  }
}
