# Snap Notes build settings. Copy to .env.local for local development.
#
# All of these are optional: without them Snap Notes is the local-only app, with no account
# screens and no network requests. Only PUBLIC values belong here. They are compiled into the
# JavaScript that every visitor downloads.
#
# NEVER put a secret key (sb_secret_...) or the service_role key here. The app refuses to start
# its account features if it sees one.

# The Supabase project URL. Local stack: http://127.0.0.1:54321 (see `npx supabase status`).
VITE_SUPABASE_URL=

# The project's publishable key (sb_publishable_...), or the legacy "anon" key.
# Local stack: the PUBLISHABLE_KEY printed by `npx supabase status`.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Where links in account emails return to. Defaults to the address the app is served
# from, e.g. http://localhost:5173/Snap-Notes/ in development.
VITE_APP_URL=
